<Window
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="MuzicBokx.AboutWindow"
	x:Name="Window"
	Title="AboutWindow"
	Width="633" Height="807" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#FF575757">

	<Window.Resources>
		<Style x:Key="ButtonStyle1" BasedOn="{x:Null}" TargetType="{x:Type Button}">
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Grid>
							<Rectangle Fill="{x:Null}" Stroke="#FFFFFFFF" StrokeThickness="9"/>
							<ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsFocused" Value="True"/>
							<Trigger Property="IsDefaulted" Value="True"/>
							<Trigger Property="IsMouseOver" Value="True"/>
							<Trigger Property="IsPressed" Value="True"/>
							<Trigger Property="IsEnabled" Value="False"/>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid x:Name="LayoutRoot">
		<Image Margin="43.5,67,40.5,0" VerticalAlignment="Top" Height="199.5" Source="./MuzicBoxzPoster.jpg" Stretch="UniformToFill">
            <Image.BitmapEffect>
                <BevelBitmapEffect Smoothness="1" />
            </Image.BitmapEffect>
        </Image>
        <Button HorizontalAlignment="Right" Margin="0,0,40.5,38" Style="{DynamicResource ButtonStyle1}" VerticalAlignment="Bottom" Width="194.5" Height="67.5" Content="OK" FontFamily="Eras ITC" FontSize="36" FontWeight="Bold" Foreground="#FFFFFFFF" Click="Button_Click"/>
        <TextBlock FontFamily="Eras ITC Bold" FontSize="24" Margin="205,305,140,0" Height="30" VerticalAlignment="Top" Foreground="White" Text="MuzicBokx v.1.5"></TextBlock>
        <TextBlock FontFamily="Eras ITC Bold" FontSize="16" Margin="205,338,202,0" Height="30" VerticalAlignment="Top" Foreground="White" >Created By: Jarred</TextBlock>
        <TextBox Margin="43.5,372,40.5,320" Name="textBox1" Cursor="IBeam" Background="#FF454545" BorderBrush="#FFBDBDBD" FontFamily="Eras ITC" FontSize="14" Foreground="#FFFFFFFF" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap">
            if you want to add more features and bug fixes and tweaks, contact me reyesgavinjarred@gmail.com
            --Jarred.
        </TextBox>
    </Grid>
</Window>