<Window
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Class="MuzicBokx.WindowLeave"
	x:Name="Window"
	Title="WindowLeave"
	Width="393" Height="234" WindowStyle="None" Background="#FF555555" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" ShowInTaskbar="False">

	<Grid x:Name="LayoutRoot">
		<TextBlock Margin="17,30,-45,0" VerticalAlignment="Top" Height="67" Background="{x:Null}" FontFamily="Eras ITC" FontSize="27" Foreground="#FFFFFFFF" Text="Are you sure to quit?" TextWrapping="Wrap"/>
		<Grid Margin="182.76,0,157.764,18.311" VerticalAlignment="Bottom" Height="73.689" MouseDown="Yes_MouseDown">
			<Grid RenderTransformOrigin="0.5,0.5">
				<Grid.RenderTransform>
					<TransformGroup>
						<ScaleTransform ScaleX="1" ScaleY="1"/>
						<SkewTransform AngleX="0" AngleY="0"/>
						<RotateTransform Angle="42.028"/>
						<TranslateTransform X="0" Y="0"/>
					</TransformGroup>
				</Grid.RenderTransform>
				<Rectangle Fill="#FFFAFAFA" Stroke="{x:Null}" StrokeThickness="7" VerticalAlignment="Bottom" Height="18"/>
				<Rectangle Fill="#FFFAFAFA" Stroke="{x:Null}" StrokeThickness="7" HorizontalAlignment="Right" Width="19"/>
			</Grid>
		</Grid>
		<Grid RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right" Margin="0,0,11.556,38.353" VerticalAlignment="Bottom" Width="83.878" Height="17.293" MouseDown="No_MouseDown">
			<Grid.RenderTransform>
				<TransformGroup>
					<ScaleTransform ScaleX="1" ScaleY="1"/>
					<SkewTransform AngleX="0" AngleY="0"/>
					<RotateTransform Angle="45"/>
					<TranslateTransform X="0" Y="0"/>
				</TransformGroup>
			</Grid.RenderTransform>
			<Rectangle Fill="#FFFAFAFA" Stroke="{x:Null}" StrokeThickness="7"/>
			<Rectangle Fill="#FFFAFAFA" Stroke="{x:Null}" StrokeThickness="7" RenderTransformOrigin="0.5,0.5">
				<Rectangle.RenderTransform>
					<TransformGroup>
						<ScaleTransform ScaleX="1" ScaleY="1"/>
						<SkewTransform AngleX="0" AngleY="0"/>
						<RotateTransform Angle="90"/>
						<TranslateTransform X="0" Y="0"/>
					</TransformGroup>
				</Rectangle.RenderTransform>
			</Rectangle>
		</Grid>
		<Rectangle Fill="#FFFAFAFA" Stroke="{x:Null}" StrokeThickness="7" Margin="0,0,0,96" VerticalAlignment="Bottom" Height="10"/>
	</Grid>
</Window>